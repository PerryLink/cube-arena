# Copy this file to `.env` in the same directory (~/cube-arena/.env) and fill in
# the values. Real environment variables always override anything set here.
# Every key is optional: a model with no credentials simply shows as
# "unavailable" in the UI, with the reason. Nothing is faked.

# ---- Cloudflare Workers AI (Clef + Clef-Flash) -----------------------------
# Needed for the Clef and Clef-Flash panels. Both are hosted on Workers AI, so
# they cost no local RAM, which is the only reason a 9B and a 27B model are
# reachable from an 8 GB machine at all.
# Create a token at dash.cloudflare.com -> My Profile -> API Tokens
# with the scope "Workers AI: Read".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# ---- Kev (local server) ----------------------------------------------------
# Kev needs no credentials here. It needs its own server running:
#   uv run --extra serve python -m kev.serve --run jaredpalmer/kev-9b --port 8008
# The 9B checkpoint wants ~32 GB for bf16 and is slow on MPS.

# ---- Hugging Face ----------------------------------------------------------
# Optional. Speeds up the first model downloads (strands-decider ~4.5 GB,
# laya ~1 GB).
HF_TOKEN=